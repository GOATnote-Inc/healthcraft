# The build context is staged explicitly; never use the repository root.
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
COPY wheels /wheels
COPY requirements-backend-linux-arm64.lock /requirements.lock
RUN python -m pip install --no-cache-dir --no-index --no-deps --require-hashes \
    --find-links=/wheels -r /requirements.lock && rm -rf /wheels
COPY src /app/src
COPY configs /app/configs
COPY LICENSE /app/LICENSE
WORKDIR /app
ENV PYTHONPATH=/app/src
CMD ["python", "-m", "healthcraft.reconciliation.http_service"]
